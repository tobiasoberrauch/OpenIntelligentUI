# Agent settings: place these in apps/agent/.env.
# Use the key for the selected provider; never expose keys to the browser.

# ── Answer model ──────────────────────────────────────────────────────────
# Open models: point LLM_BASE_URL at any OpenAI-compatible server
# (vLLM, SGLang, Ollama, llama.cpp llama-server, LiteLLM, LocalAI, TGI).
# LLM_MODEL is then the served model name, e.g. the vLLM --served-model-name
# or the Ollama tag. The model must support tool calling. See docs/open-models.md.
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_MODEL=qwen3-coder
# LLM_API_KEY=            # optional; most local servers need none
# LLM_MAX_TOKENS=         # optional; unset lets the server use the remaining context
# LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}

# Hosted providers (used when LLM_BASE_URL is unset):
# chat-latest follows ChatGPT Instant. gpt-* uses OpenAI; claude-* uses Anthropic.
# Blank or unsupported model prefixes fail at startup.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=chat-latest

# ── Visualization router ──────────────────────────────────────────────────
# Picks text / table / chart / diagram / map / calculator before each new user
# turn. Backends: jev (TypeSafe Jev), llm (any OpenAI-compatible model),
# none (the answer model chooses), auto (default: jev when TYPESAFE_API_KEY or a
# visitor's Jev key is present, otherwise llm).
# ROUTER_BACKEND=auto

# Jev (TypeSafe System One API)
TYPESAFE_API_KEY=
# JEV_MODEL=jev-latest

# llm: defaults to the answer model's endpoint; point it at a small, fast model
# to cut latency.
# ROUTER_BASE_URL=http://localhost:11434/v1
# ROUTER_MODEL=qwen2.5:3b
# ROUTER_API_KEY=
# ROUTER_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}
# ROUTER_TIMEOUT=30
# ROUTER_ON_ERROR=auto    # auto: answer model chooses on router failure; fail: fail the turn

# Frontend settings: place these in apps/app/.env.local.
# LANGGRAPH_DEPLOYMENT_URL defaults to http://localhost:8123.
# LANGGRAPH_DEPLOYMENT_URL=http://localhost:8123
# MCP_SERVER_URL=http://localhost:3100/mcp
# Visitors bring their own OpenAI key (public demos). Off by default: the agent
# uses its server-side model. Read at build time (NEXT_PUBLIC_*).
# NEXT_PUBLIC_BYOK=true

# Rate limiting (per IP) — disabled by default
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=40
